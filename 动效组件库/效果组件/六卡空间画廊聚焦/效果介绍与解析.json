      "symbols": [
        "render",
        "runIntro",
        "focusChapter",
        "returnToGallery",
        "rotateToFront",
        "onPointerDown",
        "onPointerUp",
        "toggleIndex",
        "prepareIndexPanel",
        "enterIndexPanel",
        "leaveIndexPanel"
      ],
      "purpose": "渲染、输入、按需 ticker、缩放/后退恢复和首页索引弹层。"
    }
  ],
  "mechanism": {
    "trigger": "黄幕结束或 preloaderDone 启动开场；点击卡片进入全屏舞台，全屏卡再点击通过 startJump 进入独立子页；返回按钮/Escape 反向收起。",
    "stages": [
      {
        "name": "entrance",
        "description": "entrance:0→1，orbit:-75deg→0deg，六卡半径和比例同步展开，结束自动聚焦 ABOUT。",
        "properties": [
          "GalleryState.entrance",
          "GalleryState.orbit"
        ],
        "timing": "3.6s；自定义 cubic-bezier(0.165,.84,.44,1)，非严格等价 GSAP power3.out。"
      },
      {
        "name": "focus",
        "description": "只把 focus 推到 1，选中卡的 x/z/rotateY/inset 逐渐归零、scale 到 1；其他卡保持位置并在 focus/.65 内淡出，轨道 tilt 从 -45deg 回到 0deg。",
        "properties": [
          "GalleryState.focus",
          "transform",
          "clip-path",
          "opacity"
        ],
        "timing": "1.4s；focusEase=cubic-bezier(.215,.61,.355,1)。"
      },
      {
        "name": "return",
        "description": "从当前 focus 回到 0，支持聚焦未结束时直接退回；结束通知宿主恢复画廊并消费排队切卡。",
        "properties": [
          "GalleryState.focus"
        ],
        "timing": "max(.45,1.25*当前focus) 秒；减少动态时 timeline.progress(1) 直接落终态。"
      },
      {
        "name": "orbit-input",
        "description": "拖拽带惯性吸附到 60deg 卡间距；滚轮与左右键切前景卡，pointer 邻近和三层漂移按需唤醒 ticker。",
        "properties": [
          "GalleryState.orbit",
          "drift",
          "proximity"
        ],
        "timing": "普通导航 .9s power2.out；拖拽吸附 .5~1.3s；取消拖拽 .45s。"
      },
      {
        "name": "home-index",
        "description": "首页另有 Teleport 索引，面板淡入、六行从裁切下边上移；关闭淡出。它操作同一画廊焦点，不等同于子页 SubpageIndex 的路由菜单。",
        "properties": [
          "index-panel.opacity",
          "index-row.yPercent"
        ],
        "timing": "淡入 .6s；行从 .15s 开始 .8s、stagger .04s；淡出 .4s。"
      }
    ],
    "state": [
      "渲染 Phase: intro / gallery / focusing / detail / returning",
      "GalleryState: entrance、orbit、focus、selected",
      "chapter machine 独立描述转场；同一时刻只持有一条章节时间线",
      "restoreIndex、preloaderDone、autoEnterAbout 由 GalleryView 传入",
      "lastFocusedCard / galleryLeavePosition 与 sessionStorage 面包屑完成后退识别"
    ],
    "propertyOwnership": [
      "galleryMotion 只计算，ThreeHome.render 独占 .card-position/.card-plane 的 transform、clip-path、opacity。",
      "卡内 GSAP 动效只写 CardVisual 子树，不能碰卡片空间摆放节点。",
      "漂移层 stage/orbit/card-drift 各自套壳；聚焦时 reach=1-focus，防全屏卡漂移露出黑边。"
    ],
    "interruption": [
      "每次聚焦/返回先 kill 旧章节时间线；退出从当前 focus 接续。",
      "stopMotion 清理开场、转环、转场及拖拽状态；settleGallery 先重置状态机再 render。",
      "开场 boot 有 12s 兜底；调试/后退恢复先 cancelBoot，避免迟到信号重置 state。",
      "尺寸变化重新计算几何并重建 CardVisual；短小高度变化防抖 160ms，宽度或高度差>=80px 立即更新。"
    ]
  },
  "integration": {
    "steps": [
      "将 ThreeHome 和数学层/转场层配套使用，按 CHAPTERS 维护六卡顺序。",
      "传入当前首页进入来源和 Preloader 状态；后退恢复传 restoreIndex 0..5。",
      "若只迁移 createChapterTransition，TransitionHost.state 必须与宿主每帧读的对象同一引用，并提供 render、完成回调。",
      "保留 card-position→card-drift→card-plane→CardVisual 分层。",
      "跨页跳转仍交给 App/PageCurtain；本效果的 focus 不是跨路由幕布。"
    ],
    "inputs": [
      "restoreIndex?: number|null",
      "preloaderDone?: boolean",
      "autoEnterAbout?: boolean",
      "鼠标、触控拖拽、滚轮、Enter/Space/Escape/左右键",
      "TransitionHost 的 state、focusDuration、reduced、render 和回调"
    ],
    "outputs": [
      "全屏卡与画廊两种布局",
      "startJump('01'..'06')",
      "lastFocusedCard / galleryLeavePosition",
      "本机 localhost/127.0.0.1 且 ?galleryDebug 时 window.__galleryDebug"
    ],
    "dependencies": [
      "vue",
      "gsap",
      "src/data/chapters.ts",
      "CardVisual 注册表",
      "useHomeIntroduction",
      "useCursor",
      "useTransition",
      "usePageCurtain"
    ],
    "assets": [
      "几何和卡面主要为 CSS/SVG；章节卡内容资源由 CardVisual 管理。"
    ]
  },
  "accessibility": {
    "reducedMotion": "挂载时读取媒体查询，开场与 focus 直接完成，指针漂移停用，转环采用短时长；本组件未监听该查询后续 change。",
    "touch": "Pointer Events 处理拖拽、惯性、多指取消和点击抑制；局部 wheel 为非 passive，卡片内容 pointer-events:none。",
    "keyboard": "卡片 role=button 支持 Enter/Space；左右键转环，Escape 收回；首页索引具 aria-modal、Tab 循环和关闭后焦点恢复。"
  },
  "lifecycle": {
    "setup": [
      "挂载注册 ResizeObserver、visualViewport resize、orientationchange 与输入事件。",
      "按需添加 gsap.ticker；画面落定后移除，输入/补间可再次唤醒。"
    ],
    "cleanup": [
      "卸载清 boot/resize/click 计时器、所有时间线、观察器、全局与局部输入事件及 ticker。",
      "清 cursorLockState 和 window.__galleryDebug。"
    ],
    "knownLimitations": [
      "是固定六卡的完整体验宿主，不是任意数量的通用 carousel；CARD_COUNT、ROTATIONS 和章节映射需成套修改。",
      "正交 CSS 3D 中 z 会经倾斜投影影响屏幕 y，不能照透视图库逻辑额外加后退 z 轨。",
      "CardVisual.remount 创建新动画实例，不能据 Base.introDone 推断跨实例保留入场完成标记。",
      "useHomeIntroduction 在满足正常首访条件且 ABOUT 可见四秒后可自动进入 /about；迁移须审视该产品行为。"
    ]
  },
  "agentNotes": [
    "ThreeHome 中少量历史注释仍描述旧百分比切页；当前实际跨页走 startJump→App 的路由幕布。",
    "首页索引已经在本效果源码与解析中覆盖；index-overlay 描述的是独立 SubpageIndex。",
    "verification.commands 是已有仓库检查入口；没有宣称其覆盖所有视觉位姿。"
  ],
  "relatedEffects": [
    "home-preloader",
    "route-curtain",
    "card-about",
    "card-edit",
    "card-color",
    "card-news",
    "card-poster",
    "card-photo",
    "index-overlay"
  ],
  "verification": {
    "commands": [
      "npm run typecheck",
      "node scripts/verify-runtime-navigation.mjs"
    ],
    "manualChecks": [
      "刷新首页，检查六卡绽开、ABOUT 聚焦与进入子页。",
      "聚焦中 Escape、连续切卡、拖拽后点击，检查不卡在中间状态。",
      "子页后退与子页刷新后后退，确认恢复目标卡而非重播黄幕。",
      "横竖屏切换及 844×390、320×568 视口检查裁切和控件。",
      "在本机 /?galleryDebug=1 用 snapshot/seek 检查 focus 中间帧。"
    ]
  },
